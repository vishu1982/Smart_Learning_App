# ====================================================================
# SMART LEARNING APP - BACKEND ENVIRONMENT VARIABLES
# Add these variables to your Vercel Project Settings > Environment Variables
# ====================================================================

PROJECT_NAME="Smart Learning Web Application"

# MongoDB Database Connection String
# For local dev: mongodb://localhost:27017/
# For Vercel Production: Use MongoDB Atlas (free tier):
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_learning_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=smart_learning_db

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# DeepSeek AI Configuration (for AI Tutor)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# JWT Authentication
JWT_SECRET_KEY=supersecretjwtkeyforantigravitymcaproject2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# YouTube Data API v3 (for educational video recommendations)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Email SMTP Configuration (for sending OTPs via Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password
EMAIL_FROM_NAME="Smart Learning App"
